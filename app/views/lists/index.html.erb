<div class="container py-4">
  <!-- Hero Section -->
  <div class="p-5 mb-4 bg-dark text-white rounded-3 shadow text-center position-relative overflow-hidden">
    <div class="py-4">
      <h1 class="display-4 fw-bold">Save your favorite movies</h1>
      <p class="fs-5 text-secondary">Create custom lists and curate movie watchlists for any mood.</p>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 fw-bold mb-0">My Lists</h2>
    <%= link_to "+ Create List", new_list_path, class: "btn btn-warning rounded-pill px-4 fw-semibold" %>
  </div>

  <!-- Lists Grid -->
  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% @lists.each do |list| %>
      <div class="col">
        <!-- Card Container with fixed aspect height and relative positioning -->
        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden position-relative text-white card-hover" style="min-height: 280px;">

          <!-- Background Image -->
          <% if list.photo.attached? %>
            <%= cl_image_tag list.photo.key, class: "position-absolute top-0 start-0 w-100 h-100 object-fit-cover", alt: list.name %>
          <% else %>
            <%= image_tag 'https://external-content.duckduckgo.com/iu/?u=https%3A%2F%2Fstatic.vecteezy.com%2Fsystem%2Fresources%2Fpreviews%2F021%2F548%2F751%2Flarge_2x%2Fclapper-board-for-cinematography-concept-movie-or-film-format-png.png&f=1&nofb=1&ipt=3be17f7650b971249d29feff463bc4665bb955bb728fd1f0b00d705c88a54ff4', class: "position-absolute top-0 start-0 w-100 h-100 object-fit-cover", alt: list.name %>
          <% end %>

          <!-- Dark Gradient Overlay for Text Legibility -->
          <div class="position-absolute top-0 start-0 w-100 h-100" style="background: linear-gradient(180deg, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.85) 100%);"></div>

          <!-- Card Content placed above the image and gradient -->
          <div class="card-body p-4 d-flex flex-column justify-content-end position-relative z-1">
            <h3 class="h4 card-title fw-bold text-white mb-1"><%= list.name %></h3>
            <p class="text-white-50 small mb-3"><%= pluralize(list.movies.count, "movie") %></p>

            <div>
              <%= link_to "View List", list_path(list), class: "btn btn-light w-100 rounded-pill btn-sm fw-semibold shadow-sm" %>
            </div>
          </div>

        </div>
      </div>
    <% end %>
  </div>
</div>
