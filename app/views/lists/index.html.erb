<div class="container">
  <!-- Hero Section -->
  <div class="p-5 mb-4 bg-dark text-white rounded-3 shadow text-center position-relative overflow-hidden">
    <div class="py-4">
      <h1 class="display-4 fw-bold">Save your favorite movies</h1>
      <p class="fs-5 text-secondary">Create custom lists and curate movie watchlists for any mood.</p>
    </div>
  </div>

  <div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="h4 fw-bold mb-0">My Lists</h2>
    <%= link_to "+ Create List", new_list_path, class: "btn btn-warning rounded-pill px-4" %>
  </div>

  <!-- Lists Grid -->
  <div class="row row-cols-1 row-cols-md-3 g-4">
    <% @lists.each do |list| %>
      <div class="col">
        <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden card-hover">
          <div class="card-body p-4 d-flex flex-column justify-content-between">
            <div>
              <h3 class="h5 card-title fw-bold text-dark"><%= list.name %></h3>
              <p class="text-muted small mb-0"><%= pluralize(list.movies.count, "movie") %></p>
            </div>
            <div class="mt-4 pt-3 border-top">
              <%= link_to "View List", list_path(list), class: "btn btn-outline-dark w-100 rounded-pill btn-sm" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
