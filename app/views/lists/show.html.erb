<div class="container">
  <!-- Header / Action Bar -->
  <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
    <div>
      <%= link_to "← Back to Lists", lists_path, class: "text-decoration-none text-muted small" %>
      <h1 class="fw-bold mt-1"><%= @list.name %></h1>
    </div>
    <%= link_to "Add Movie", new_list_bookmark_path(@list), class: "btn btn-warning rounded-pill px-4" %>
  </div>

  <!-- Movies Grid -->
  <% if @list.bookmarks.any? %>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
      <% @list.bookmarks.each do |bookmark| %>
        <div class="col">
          <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">
            <img src="<%= bookmark.movie.poster_url %>" class="card-img-top object-fit-cover" alt="<%= bookmark.movie.title %>" style="height: 320px;">

            <div class="card-body d-flex flex-column">
              <div class="d-flex justify-content-between align-items-start mb-2">
                <h5 class="card-title fw-bold text-dark mb-0"><%= bookmark.movie.title %></h5>
                <span class="badge bg-warning text-dark"><i class="bi bi-star-fill text-dark me-1"></i><%= bookmark.movie.rating %></span>
              </div>

              <p class="card-text text-muted small flex-grow-1"><%= truncate(bookmark.movie.overview, length: 110) %></p>

              <!-- Bookmark Comment Box -->
              <div class="bg-light p-3 rounded-3 mt-3 border">
                <p class="mb-0 small text-dark"><i class="bi bi-quote me-1 text-warning"></i><em>"<%= bookmark.comment %>"</em></p>
              </div>
            </div>

            <div class="card-footer bg-transparent border-0 text-end pb-3 pe-3">
              <%= link_to bookmark_path(bookmark), data: { turbo_method: :delete, turbo_confirm: "Remove from list?" }, class: "text-danger small text-decoration-none" do %>
                <i class="bi bi-trash me-1"></i>Delete
              <% end %>
            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <div class="text-center py-5">
      <p class="text-muted fs-5">No movies in this list yet.</p>
      <%= link_to "Add your first movie", new_list_bookmark_path(@list), class: "btn btn-outline-warning rounded-pill" %>
    </div>
  <% end %>
  <hr class="my-5">

  <div class="row g-4">
    <!-- Reviews List -->
    <div class="col-md-7">
      <h3 class="h4 fw-bold mb-3">
        Reviews
        <span class="badge bg-secondary rounded-pill fs-6"><%= @list.reviews.count %></span>
      </h3>

      <% if @list.reviews.any? %>
        <div class="d-flex flex-column gap-3">
          <% @list.reviews.order(created_at: :desc).each do |review| %>
            <div class="card border-0 shadow-sm p-3">
              <div class="d-flex justify-content-between align-items-center mb-2">
                <div class="text-warning">
                  <% review.rating.times do %>
                    <i class="fa-solid fa-star"></i>
                  <% end %>
                  <% (5 - review.rating).times do %>
                    <i class="fa-regular fa-star text-muted"></i>
                  <% end %>
                  <span class="fw-bold text-dark ms-1">(<%= review.rating %>/5)</span>
                </div>
                <small class="text-muted">
                  <%= time_ago_in_words(review.created_at) %> ago
                </small>
              </div>
              <p class="mb-0 text-secondary"><%= review.content %></p>
            </div>
          <% end %>
        </div>
      <% else %>
        <p class="text-muted fst-italic">No reviews yet. Be the first to leave one!</p>
      <% end %>
    </div>

    <!-- Review Submission Form -->
    <div class="col-md-5">
      <div class="card border-0 shadow-sm p-4 bg-light">
        <h3 class="h5 fw-bold mb-3">Add a Review</h3>

        <%= simple_form_for [@list, @review] do |f| %>
          <%= f.input :rating, collection: 0..5, prompt: "Select rating (0-5)", input_html: { class: "form-select mb-3" } %>
          <%= f.input :content, label: "Your review", placeholder: "What did you think of this list?", input_html: { rows: 3, class: "form-control mb-3" } %>
          <%= f.button :submit, "Submit Review", class: "btn btn-primary w-100 fw-semibold" %>
        <% end %>
      </div>
    </div>
  </div>
</div>
